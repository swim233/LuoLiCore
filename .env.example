BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LUOLI_OWNER_ID=8899001
LUOLI_MASTER_KEY=change-me-to-at-least-32-bytes-random
WEBUI_PASSWORD=change-me
TZ=Asia/Shanghai
NODE_ENV=production

# 仅容器形态（docker compose）需要，宿主形态留空即可：
# 1) 容器以非 root 用户跑，要进宿主 docker 组才读得到挂进来的 /var/run/docker.sock。
#    不用 docker 沙箱（sandbox.mode: none | jail）时填 0。
DOCKER_GID=
# 2) 沙箱的 `docker run -v` 由宿主 daemon 解析，容器内的 /app/data/workspace 在宿主上不存在。
#    docker-compose.yml 已按 ${PWD}/data/workspace 提供；从别的目录跑 compose 时在这里显式给绝对路径。
# LUOLI_HOST_WORKSPACE_DIR=/srv/luoli/data/workspace
