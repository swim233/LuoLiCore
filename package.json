{
  "name": "luolicore",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "start": "pnpm web:build && pnpm serve",
    "serve": "tsx --env-file-if-exists=.env src/server/main.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli/main.ts",
    "requests": "tsx --env-file-if-exists=.env src/requests/main.ts",
    "web:dev": "vite src/web",
    "web:build": "vite build src/web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/react": "4.0.160",
    "@chat-adapter/state-memory": "4.43.0",
    "@chat-adapter/telegram": "4.43.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.14.26",
    "ai": "7.0.156",
    "chat": "4.43.0",
    "hono": "4.13.17",
    "linkedom": "^0.18.15",
    "motion": "^14.10.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.4",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
