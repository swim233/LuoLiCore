{
  "name": "luolicore",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/cli/main.ts",
    "telegram": "tsx --env-file-if-exists=.env src/telegram/main.ts",
    "requests": "tsx --env-file-if-exists=.env src/requests/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@chat-adapter/state-memory": "4.43.0",
    "@chat-adapter/telegram": "4.43.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.156",
    "chat": "4.43.0",
    "linkedom": "^0.18.15",
    "pino": "^10.4.0",
    "turndown": "^7.2.4",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
