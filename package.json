{
  "name": "luolicore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env apps/bot/src/main.ts",
    "start": "node --env-file-if-exists=.env dist/apps/bot/src/main.js",
    "build": "pnpm webui:build && tsc -p tsconfig.build.json && tsx scripts/postbuild.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "config:schema": "tsx scripts/config-schema.ts",
    "webui:build": "vite build --config packages/webui/vite.config.ts",
    "webui:dev": "vite --config packages/webui/vite.config.ts",
    "webui:passwd": "tsx scripts/passwd.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@hono/node-server": "^1.19.1",
    "@luoli/core": "workspace:*",
    "@luoli/db": "workspace:*",
    "@luoli/plugin-sdk": "workspace:*",
    "@luoli/server": "workspace:*",
    "@luoli/shared": "workspace:*",
    "@luoli/telegram": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.65",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "grammy": "^1.38.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.9.2",
    "mammoth": "^1.12.1",
    "marked": "^16.2.1",
    "minimatch": "^10.0.3",
    "pdf-parse": "^2.4.5",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "re2-wasm": "^1.0.2",
    "sharp": "^0.35.3",
    "ulid": "^3.0.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "yaml": "^2.8.1",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
